class Solution {
    public void sortColors(int[] nums) {
		int[] count = new int[3];
		
		for (int num : nums) {
			count[num] ++;
		}

		for (int i = 1; i < 3; i++) {
			count[i] += count[i -1];
		}
		
		int[] output = new int[nums.length];
		for (int i = nums.length -1; i >= 0; i--) {
			int val = nums[i];
			output[-- count[val]] = val;
		}
		
		for (int i = 0; i < nums.length; i++) {
			nums[i] = output[i];
		}
	}
}
