class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
		int n = grid.length;
		int repeated = 0;
		int notFound = 0;
		
		int[] array = new int[n * n + 1];
		
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < n; j++) {
				array[grid[i][j]]++;
			}
		}
		
		for (int i = 1; i < array.length; i++) {
			if (array[i] == 0) {
				notFound = i;
			}
			
			if (array[i] == 2) {
				repeated = i;
			}
		}
		
		return new int[] {repeated, notFound};
	}
}
