
import java.util.*;

class SnakeGame {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("n = ");
        int n = sc.nextInt();
        System.out.print("m = ");
        int m = sc.nextInt();
        int[][] mt = matrix(n, m) ;

        print(mt);
    }

    public static int[][] matrix(int n, int m) {
        int[][] matrix = new int[n][m];
        int top = 0;
        int bottom = n - 1;
        int left = 0;
        int right = m - 1;

        int counter = 1;

        while (top <= bottom) {

            for (int j = left; j <= right; j++) {
                matrix[top][j] = counter++;
            }
            top++;


            if (top > bottom) break;

            for (int i = right; i >= left; i--) {
                matrix[top][i] = counter++;
            }
            top++;
        }

        return matrix;
    }

    public static void print(int[][] matrix) {
        int n = matrix.length;
        int m = matrix[0].length;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                System.out.print(matrix[i][j] + "\t ");
            }
            System.out.println();
        }
    }
}

