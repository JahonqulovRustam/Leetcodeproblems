public void showStudents() {

        System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
                "ID", "Ism", "Familiya", "Reyting", "Kurs");

        System.out.println("-------------------------------------------------------");

        for (int i = 0; i < rows; i++) {
            show(i);
        }
    }

public void showStudentsById(int id) {

        System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
                "ID", "Ism", "Familiya", "Reyting", "Kurs");

        System.out.println("-------------------------------------------------------");

        for (int i = 0; i < rows; i++) {
            if ((int) students[i][0] == id) {
                show(i);
                return;
            }
        }

        System.out.println("Bunday ID topilmadi!");
    }

void show(int index) {
        System.out.printf("%-5d %-15s %-15s %-8.2f %-5d%n",
                (int) students[index][0],
                students[index][1],
                students[index][2],
                (double) students[index][3],
                (int) students[index][4]);
    }
