public static void menu() {
        System.out.println("1. Student qo'shish");
        System.out.println("2. Studentlar ro'yxati");
        System.out.println("3. ID bo'yicha qidirish");
        System.out.println("4. Tahrirlash");
        System.out.println("5. O'chirish");
        System.out.println("6. Chiqish");
    }

public static void  main(String[] args) {
        Scanner sc = new Scanner(System.in);
        StudentList studentList = new StudentList();
        Object[][] students = studentList.students;

        while (true) {

            menu();

            System.out.print("\nAmaliyotni bajarish uchun tanlang: ");
            int num = sc.nextInt();

            if (students.length == 0) {
                System.out.println("Birinchi student qo'shgan ma'qul!");
            }

            switch (num) {

                case 1 : studentList.addStudent(); break;

                case 2 : studentList.showStudents(); break;

                case 3 :
                    System.out.print("ID ni kiriting: ");
                    int id = sc.nextInt();

                    studentList.showStudentsById(id);
                    break;

                case 4 :
                    System.out.print("ID ni kiriting: ");
                    int ayd = sc.nextInt();

                    studentList.updateStudentById(ayd);
                    break;

                case 5 :
                    System.out.print("ID ni kiriting: ");
                    int ad = sc.nextInt();

                    studentList.deleteStudentById(ad);
                    studentList.students = students;
                    break;

                case 6 :
                    sc.close();
                    return;

                default:
                    System.out.println("Bunday amal bajarish imkoniyati yo'q!");
            }
        }
    }

