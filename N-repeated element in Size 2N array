class Solution {

    public int repeatedNTimes(int[] nums) {
        int n = nums.length / 2;

        int max = nums[0];
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] > max) {
                max = nums[i];
            }
        }

        int[] countArr = new int[max +1];
        for (int i = 0; i < nums.length; i++) {
            countArr[nums[i]] ++;
        }

        int result = 0;
        for (int i = 0; i <= max; i++) {
            if (countArr[i] == n) {
                result = i;
            }
        }
        
        return result;
    }
}
