public class Anagram {
	
	public String makeAnagram(String s) {
	
		int[] count = new int[256];
		
		for (int i = 0; i < s.length(); i++) {
			count[s.charAt(i)] ++;
		}
		
		StringBuilder sb = new StringBuilder();
		
		for (int i = 0; i < 256; i++) {
			
			while (count[i] > 0) {
				sb.append((char) i);
				count[i] --;
			}
		}
		
		return sb.toString();
	}
	
	public String lowercaseStringAnagram(String s) {
		int[] count = new int[26];
		
		for (int i = 0; i < s.length(); i++) {
			count[s.charAt(i) - 'a'] ++;
		}
		
		StringBuilder sb = new StringBuilder();
		
		for (int i = 0; i < 26; i++) {
			
			while (count[i] > 0) {
				sb.append((char) (i + 'a'));
				count[i] --;
			}
		}
		
		return sb.toString();
	}
}
