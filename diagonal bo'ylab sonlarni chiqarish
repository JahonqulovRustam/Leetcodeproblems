
import java.util.*;

public class DiagonalMovement {
	
	public static int[][] showDiagonalNums(int n, int m) {
		
		int[][] matrix = new int[n][m];
		int count = 1;
		
		for (int k = 0; k < n + m - 1; k++) {
			int i, j;
			
			if (k % 2 == 0) {
				if (k < n) {
					i = k;
					j = 0;
				} else {
					i = n - 1;
					j = k - (n - 1);
				}
				
				while (i >= 0 && j < m) {
					matrix[i][j] = count++;
					i--;
					j++;
				}
			} else {
				if (k < m) {
					i = 0;
					j = k;
				} else {
					i = k - (n - 1);
					j = n - 1;
				}
				
				while (j >= 0 && i < n) {
					matrix[i][j] = count++;
					i++;
					j--;
				}
			}
		}
		
		return matrix;
	}
	
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		System.out.print("N sonini kiriting: ");
		int n = sc.nextInt();
		
		System.out.print("M sonini kiriting: ");
		int m = sc.nextInt();
		int[][] array = showDiagonalNums(n, m);
		print(array);
	}
	
	public static void print(int[][] matrix) {
		int n = matrix.length;
		int m = matrix[0].length;
		
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < m; j++) {
				System.out.print(matrix[i][j] + "\t ");
			}
			System.out.println();
		}
	}
}
