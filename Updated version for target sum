
import java.util.*;


public class SumSolver {

    public static Set<List<Integer>> solve(int[] nums, int target) {
        int n = nums.length;

        Set<List<Integer>> result = new HashSet<>();

        for (int i = 0; i < (1 << n); i++) {

            int sum = 0;
            List<Integer> list = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                if ((i & (1 << j)) != 0) {
                    sum += nums[j];
                    list.add(nums[j]);
                }
            }

            if (sum == target && !list.isEmpty()) {
                Collections.sort(list);
                result.add(list);
            }
        }

        return result;
    }


    public static void main(String[] args) {

            int[] nums = new Random().ints(16,3,150).toArray();


            Set<List<Integer>> result = solve(nums, 467);
            System.out.println(result);
            System.out.println(result.size());
    }
}


