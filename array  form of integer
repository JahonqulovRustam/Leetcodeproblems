class Solution {
    public static String addStrings(String num1, String num2) {
        String number1 = new StringBuilder(num1).reverse().toString();
        String number2 = new StringBuilder(num2).reverse().toString();

        int i = 0;
        int carry = 0;

        StringBuilder result = new StringBuilder();
        while (i < number1.length() || i < number2.length() || carry != 0) {
            int x = (i < number1.length() ? number1.charAt(i) - '0' : 0);
            int y = (i < number2.length() ? number2.charAt(i) - '0' : 0);

            int sum = x + y + carry;
            carry = sum / 10;
            int digit = sum % 10;

            result.append(digit);

            i++;
        }

        return result.reverse().toString();
    }


    public List<Integer> addToArrayForm(int[] num, int k) {
       StringBuilder sb = new StringBuilder();
       for (int n : num) {
           sb.append(n);
       }

       String res = addStrings(sb.toString(), String.valueOf(k));
       List<Integer> result = new ArrayList<>();
       
       for (int i = 0; i < res.length(); i++) {
           result.add(res.charAt(i) - '0');
       }
    
     return result;  
    }
}
