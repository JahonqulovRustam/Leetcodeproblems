class Solution {

    public int[] separateDigits(int[] nums) {

        StringBuilder sb = new StringBuilder();
        for (int num : nums) {
            sb.append(num);
        }

        int len = sb.length();

        int[] output = new int[len];
        int i = 0;
        for (char c : sb.toString().toCharArray()) {
            output[i++] = c - '0';
        }

        return output;
    }
}
