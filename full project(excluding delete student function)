import java.util.*;

public class StudentList {

    Scanner sc = new Scanner(System.in);

    Object[][] students = new Object[10][5];

    int rows = 0;
    int nextID = 1;

    public void addStudent() {

        if (rows >= students.length) {
            System.out.println("Ro'yxat to'ldi!");
        }

        students[rows][0] = nextID++;

        System.out.print("Ismi: ");
        students[rows][1] = sc.next();

        System.out.print("Familiyasi: ");
        students[rows][2] = sc.next();

        System.out.print("Reytingi: ");
        students[rows][3] = sc.nextDouble();

        System.out.print("Kursi: ");
        students[rows][4] = sc.nextInt();

        rows++;
    }

    public void showStudents() {

        System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
                "ID", "Ism", "Familiya", "Reyting", "Kurs");

        System.out.println("-------------------------------------------------------");

        for (int i = 0; i < rows; i++) {
            show(i);
        }
    }

    public void showStudentsById(int id) {

        System.out.printf("%-5s %-15s %-15s %-8s %-5s%n",
                "ID", "Ism", "Familiya", "Reyting", "Kurs");

        System.out.println("-------------------------------------------------------");

        for (int i = 0; i < rows; i++) {
            if ((int) students[i][0] == id) {
                show(i);
                return;
            }
        }

        System.out.println("Bunday ID topilmadi!");
    }

    public void updateStudentById(int id) {
        for (int i = 0; i < rows; i++) {
            if ((int) students[i][0] == id) {
                System.out.print("Studentni tahrirlovchi parametrini yozing: ");
                String str = sc.next();

                switch (str.toLowerCase()) {
                    case "ismi" :
                        System.out.print("Ismni kiriting: ");
                        students[i][1] = sc.next();
                        break;

                    case "familiyasi" :
                        System.out.print("Familiyasini kiriting: ");
                        students[i][2] = sc.next();
                        break;

                    case "reytingi" :
                        System.out.print("Reytingni kiriting: ");
                        students[i][3] = sc.nextDouble();
                        break;

                    case "kursi" :
                        System.out.print("Kursini kiriting: ");
                        students[i][4] = sc.nextInt();
                        break;

                    default :
                        System.out.println("Bunday parametr mavjud emas!");
                }
                return;
            }
        }

        System.out.println("Bunday ID topilmadi");
    }

    public void deleteStudentById(int id) {

    }


    void show(int index) {
        System.out.printf("%-5d %-15s %-15s %-8.2f %-5d%n",
                (int) students[index][0],
                students[index][1],
                students[index][2],
                (double) students[index][3],
                (int) students[index][4]);
    }

    public static void menu() {
        System.out.println("1. Student qo'shish");
        System.out.println("2. Studentlar ro'yxati");
        System.out.println("3. ID bo'yicha qidirish");
        System.out.println("4. Tahrirlash");
        System.out.println("5. O'chirish");
        System.out.println("6. Chiqish");
    }


    public static void  main(String[] args) {
        Scanner sc = new Scanner(System.in);
        StudentList studentList = new StudentList();
        Object[][] students = studentList.students;

        while (true) {

            menu();

            System.out.print("\nAmaliyotni bajarish uchun tanlang: ");
            int num = sc.nextInt();

            if (students.length == 0) {
                System.out.println("Birinchi student qo'shgan ma'qul!");
            }

            switch (num) {

                case 1 : studentList.addStudent(); break;

                case 2 : studentList.showStudents(); break;

                case 3 :
                    System.out.print("ID ni kiriting: ");
                    int id = sc.nextInt();

                    studentList.showStudentsById(id);
                    break;

                case 4 :
                    System.out.print("ID ni kiriting: ");
                    int ayd = sc.nextInt();

                    studentList.updateStudentById(ayd);
                    break;

                case 5 :
                    System.out.print("ID ni kiriting: ");
                    int ad = sc.nextInt();

                    studentList.deleteStudentById(ad);
                    studentList.students = students;
                    break;

                case 6 :
                    sc.close();
                    return;

                default:
                    System.out.println("Bunday amal bajarish imkoniyati yo'q!");
            }
        }
    }


}

